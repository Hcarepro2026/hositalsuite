# ============================================================
# Hospital Admin Manager Suite — environment configuration
# Copy to `.env` and fill in real values. NEVER commit secrets.
# ============================================================

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
# SQLite (default) or PostgreSQL, e.g.:
# DATABASE_URL=postgresql://hospuser:PASS@db-host:5432/hospitalsuite
DATABASE_URL=sqlite:///data/app.db
TIMEZONE=Africa/Lagos
# Public base URL used inside QR codes, links and report verification
PUBLIC_BASE_URL=http://localhost:8077

# --- WhatsApp Business Cloud API (Meta) ---
# Leave blank to run in "sandbox" mode (delivery simulated + logged).
WHATSAPP_MODE=sandbox                 # sandbox | cloud | disabled
WHATSAPP_PHONE_NUMBER_ID=             # Meta phone-number-id
WHATSAPP_ACCESS_TOKEN=                # permanent system-user token
WHATSAPP_VERIFY_TOKEN=                # webhook verification token
WHATSAPP_APP_SECRET=                  # optional: webhook signature check
WHATSAPP_REPORT_TEMPLATE=             # approved template name (optional)
WHATSAPP_SIMULATE_FAILURE=0           # sandbox: 1 = first send fails to demo retry

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hospital Suite <no-reply@example.org>
SMTP_TLS=1

# --- USSD (optional, Nigerian aggregator) ---
# The app exposes a JSON intake API (/api/v1/ussd/complaint) that any
# USSD provider (e.g. Africa's Talking, HollaTags, Termii) can POST to.
USSD_SHARED_SECRET=

# --- Backups ---
BACKUP_DIR=data/backups
BACKUP_KEEP=14
